# pptxkit environment. Copy to .env (bin/setup does this for you).
#
# pf-core reads a number of env vars (API keys, LOG_LEVEL, the resolve_* knobs);
# see pf-core's docs/config.md and docs/env.md for the full reference. Add this
# project's own settings below as you declare them on Config in src/pptxkit/config.py.

# LOG_LEVEL=INFO

# --- pptxkit rendering ---
# Slide rasterization (pptxkit.services.render): LibreOffice + Poppler.
# PPTXKIT_SOFFICE=soffice
# PPTXKIT_PDFTOPPM=pdftoppm
# PPTXKIT_RENDER_DPI=110
# HTML-card screenshots (pptxkit.services.htmlshot). Defaults to the first
# Chrome/Chromium/Edge found; set explicitly if autodetect misses it.
# PPTXKIT_CHROME=/Applications/Google Chrome.app/Contents/MacOS/Google Chrome
# PPTXKIT_SHOT_SCALE=2
# Chrome's sandbox is ON by default because a card's HTML can carry script.
# Set this in a container that denies unprivileged user namespaces.
# PPTXKIT_CHROME_NO_SANDBOX=1
# PPTXKIT_SHOT_TIMEOUT_S=60
# Render canvas height in CSS px. A card taller than this is clipped by the
# browser; pptxkit detects that and fails the build telling you to raise it.
# PPTXKIT_SHOT_CANVAS_H=4000

# --- pptxkit QA ---
# QA text extraction (pptxkit.qa.textflow): Poppler's pdftotext.
# PPTXKIT_PDFTOTEXT=pdftotext
# PPTXKIT_PDFTOTEXT_TIMEOUT_S=60

# --- pptxkit build ---
# Both default to paths relative to the CWD; override when running the CLI
# from outside the repo root. This directory holds brand templates and the
# themes bound to them, side by side. A theme name not found there falls back
# to the packaged built-ins, so `theme: base` resolves anywhere.
# PPTXKIT_THEME_DIR=templates
# PPTXKIT_CACHE_DIR=.pptxkit-cache  # also holds rendered panel PNGs
# Glyph directory searched before the theme's own icons: and the built-in set.
# PPTXKIT_ICON_DIR=
